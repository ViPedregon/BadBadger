[Unit]
Description=Verified local BadBadger save snapshot
After=badbadger.service

[Service]
Type=oneshot
User=badbadger
Group=badbadger
ExecStart=/opt/badbadger/venv/bin/python /opt/badbadger/deploy/hourly_backup.py
StateDirectory=badbadger
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/badbadger
